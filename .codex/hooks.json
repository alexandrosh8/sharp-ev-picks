{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -C \"$PWD\" rev-parse --show-toplevel)/.codex/hooks/pre_bash_guard.sh\"",
            "timeout": 10,
            "statusMessage": "Safety-checking command..."
          },
          {
            "type": "command",
            "command": "bash \"$(git -C \"$PWD\" rev-parse --show-toplevel)/.codex/hooks/pre_commit_secret_scan.sh\"",
            "timeout": 120,
            "statusMessage": "Scanning staged changes for secrets..."
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -C \"$PWD\" rev-parse --show-toplevel)/.codex/hooks/post_edit_validate.sh\"",
            "timeout": 180,
            "statusMessage": "Formatting changed Python and running regression tests..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$(git -C \"$PWD\" rev-parse --show-toplevel)/.codex/hooks/stop_memory_reminder.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
