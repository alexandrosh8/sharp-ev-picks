# =============================================================================
# Manual-Betting +EV Picks Platform (betting-ai) — environment template
# Copy to .env and fill in values. NEVER commit .env.
# =============================================================================

APP_ENV=local
LOG_LEVEL=INFO

# --- Infrastructure -----------------------------------------------------------
# Host ports 5433/6380 — 5432/6379 are occupied by the weatherbot project.
# These URLs are for HOST-run processes (alembic, scripts/, pytest, the dev
# server). The compose `app` service OVERRIDES them with in-container service
# hostnames (postgres:5432 / redis:6379) in its environment block — do NOT
# change these to postgres:/redis: or every host-run tool breaks.
DATABASE_URL=postgresql+asyncpg://betting_ai:betting_ai@localhost:5433/betting_ai
REDIS_URL=redis://localhost:6380/0
# Bounded Redis socket timeouts (seconds) — a blackholed Redis surfaces as a
# TimeoutError instead of stalling the event loop indefinitely (WP7).
REDIS_SOCKET_CONNECT_TIMEOUT_SECONDS=5.0
REDIS_SOCKET_TIMEOUT_SECONDS=10.0

# Postgres password for the compose stack. This explicit value is a
# LOOPBACK-ONLY LOCAL FIXTURE matching DATABASE_URL above; production startup
# rejects it as a known default. Replace it with a URL-safe random value in the
# VPS .env BEFORE first boot (pgdata keeps the first password).
POSTGRES_PASSWORD=betting_ai

# VPS ONLY — uncomment so plain `docker compose up -d` includes the app
# service (it is behind the "prod" profile). Leave commented on the Mac,
# where the app runs on the host and `up -d` should start postgres/redis only.
#COMPOSE_PROFILES=prod

# Host interface for the compose app port. Production requires loopback: use an
# SSH tunnel or a same-host TLS reverse proxy and never expose port 8000
# directly. Postgres and Redis also stay loopback-only in docker-compose.yml.
APP_HOST_BIND=127.0.0.1

# --- SAFETY FLAGS (decision-support only) --------------------------------------
# This platform recommends picks; the user reviews and places bets manually.
# There is NO auto-betting capability by design: no code path can place a bet,
# and app/config.py hard-fails at startup if these defaults are tampered with.
PICKS_ONLY=true
MANUAL_BETTING_ONLY=true
AUTO_BETTING=false
BET_EXECUTION_ENABLED=false
READ_ONLY_MARKET_DATA=true
PAPER_TRADING=false

# --- Pick gates ----------------------------------------------------------------
MIN_EDGE=0.03
MIN_EV=0.01
MIN_CONFIDENCE=0.60
MAX_ODDS_AGE_SECONDS=300
MIN_LIQUIDITY=0

# --- Recommended stake sizing (informational only) ------------------------------
BANKROLL_BASE=1000
FRACTIONAL_KELLY=0.25
MAX_RECOMMENDED_STAKE_PERCENT=0.02
MAX_DAILY_EXPOSURE_PERCENT=0.05
# Per-event correlation backstop: combined recommended exposure across multiple
# +EV selections on the SAME event_id is bounded by this cap (Kelly assumes
# independent bets). Default-conservative: ON, between the per-bet and daily
# caps. Set EVENT_EXPOSURE_CAP_ENABLED=false to bind by the daily cap only.
EVENT_EXPOSURE_CAP_ENABLED=true
MAX_EVENT_EXPOSURE_PERCENT=0.04

# --- Alerts ---------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
WEBHOOK_URL=
# How long an UNCHANGED market state stays suppressed (seconds; default 7
# days). A price move re-alerts immediately regardless — the dedupe key
# includes the odds. Failed deliveries release the claim and retry next cycle.
ALERT_DEDUPE_TTL_SECONDS=604800

# --- Dashboard auth -----------------------------------------------------------------
# ENABLED by default. Local loopback mode may leave HASH/SECRET blank and use
# the one-time /setup screen, which stores the salted hash in the DB.
# APP_ENV=production disables /setup and requires BOTH HASH and SECRET before
# startup; it also requires APP_HOST_BIND to remain loopback. The plaintext is
# never stored.
#   hash:   uv run python -c "from app.api.auth import hash_password; print(hash_password('YOUR_PASSWORD'))"
#   secret: uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
# Wrap the hash in single quotes in .env because Docker Compose interpolates
# unquoted $ characters.
# /live stays public for process probes. Anonymous /ready and /health responses
# expose only coarse status; component diagnostics require authentication.
DASHBOARD_AUTH_ENABLED=true
DASHBOARD_AUTH_USERNAME=admin
DASHBOARD_AUTH_PASSWORD_HASH=
DASHBOARD_SESSION_SECRET=
# DASHBOARD_SESSION_TTL_SECONDS=43200

# --- Pick strategy -----------------------------------------------------------------
# "value" (default): sharp-vs-soft line shopping — BACKTESTED positive holdout
#   CLV (docs/backtesting/value-findings.md). "model": Dixon-Coles screens only.
# Defaults = v4 train-chosen optimum over 7 devig methods with the 1.60
# odds floor (differential-margin devig, edge >= 0.03): holdout n=61,
# ROI +21.1%, incremental CLV +0.106 > 2SE; shin/0.03 indistinguishable.
# Volume tier: VALUE_MIN_EDGE=0.015 (v2 holdout n=379, ROI +2.5%, CLV +0.019).
PICK_STRATEGY=value
VALUE_MIN_EDGE=0.03
# Volume tier floor: edges in [VALUE_VOLUME_MIN_EDGE, VALUE_MIN_EDGE) persist
# as tier='volume' — no alert, no daily-exposure reservation, CLV-tracked
# only (v2 holdout n=379, CLV +0.019). Must be <= VALUE_MIN_EDGE; set EQUAL
# to disable the volume tier.
VALUE_VOLUME_MIN_EDGE=0.015
# Floor on candidate odds = the VALIDATED floor (1.30). A 2026-06-18 held-out
# floor sweep showed 1.60->1.30 adds ~1 pick over two seasons (ROI/CLV
# unchanged) and below 1.30 only admits the noisy short-odds region; raise to
# be more conservative.
VALUE_MIN_ODDS=1.30
# POWER is the canonical shift-family default (ADR-0006). Any DevigMethod value
# EXCEPT multiplicative (rejected at startup — ~6-8 SE worse on 3-way 1X2,
# favourite-longshot trap; research 2026-06-30).
VALUE_DEVIG=power
# ML value filter (meta-labeling; docs/research/ml-value-filter.md, ADOPT
# 2026-06-12: holdout n=396, ROI +12.0%, incCLV_max +0.0357 ± 0.0075 2SE).
# false (default): scores annotate picks only. true: premium picks scoring
# below the manifest operating point demote to the volume (shadow) tier.
# Artifacts (manifest+model) are NOT in git — see docs/deployment/.
VALUE_ML_FILTER=false
VALUE_ML_MODEL_DIR=data/ml
# Manifest/model filenames inside VALUE_ML_MODEL_DIR. Defaults = the v1
# ADOPT artifacts. The v2 retrain (docs/research/premium-tier-v2.md) is a
# SHADOW-CANDIDATE (verdict CANDIDATE — 2425+2526 are a SPENT holdout, so
# its binding verdict is live shadow CLV + the fresh 2627 season): to score
# it live for ANNOTATION ONLY set the three lines below. Demotion never
# happens on a shadow manifest, even with VALUE_ML_FILTER=true.
#VALUE_ML_MANIFEST_FILENAME=value_filter_manifest_v2.json
#VALUE_ML_MODEL_FILENAME=value_filter_model_v2.txt
#VALUE_ML_MANIFEST_ALLOW_SHADOW=true
# Premium-tier adjustment knobs (2026-06 strategy research) — ALL OFF by
# default (empty = exactly the validated behavior above). Do NOT enable
# without nested season-blocked walk-forward evidence within seasons <=2324
# or a never-consulted fresh domain — 2425+2526 are a SPENT holdout
# (docs/backtesting/value-findings.md, .claude/memory/decisions.md).
# Per-market PREMIUM min-edge overrides, csv "market_key:edge" (keys = the
# line-qualified market, e.g. 1x2 / over_under_2_5 / asian_handicap_-1_5,
# or a family: h2h / totals). Example: 1x2:0.04,over_under_2_5:0.035
# 2026-07-10 evidence gate: soccer totals trusted sharp-CLV is -6.0% (n=24,
# 95% CI excludes 0; post-mortem verdict "market-signal" —
# docs/research/2026-07-10-totals-postmortem.md) -> totals is PREMIUM-BLOCKED
# via a prohibitive family floor (demote-not-drop: picks still mint as volume
# and keep accruing CLV evidence). NOTE the 'totals' key is family-wide, not
# per-sport — moot today because only soccer is premium-eligible.
# Re-promote ONLY when trusted totals CLV 95% CI > 0 at n >= 50
# (docs/superpowers/plans/2026-07-10-strategy-revision.md Task 3).
# 2026-07-11 (ADR-0022 criterion 8, operator-signed): btts premium-blocked —
# BTTS has no trusted-close instrument (0/70; arcadia lacks BTTS), so premium
# BTTS picks can never be CLV-validated. Re-promote only when a verifiable
# sharp-close source exists AND trusted BTTS CLV 95% CI > 0 at n >= 50.
VALUE_MIN_EDGE_PER_MARKET=totals:0.99,btts:0.99
# Per-market DATA-ERROR ceiling overrides, csv "market_key:ceiling" — the
# per-market sibling of VALUE_MAX_EDGE (same key rules as above). Empty = every
# market uses the global VALUE_MAX_EDGE (bit-identical). Each ceiling must be in
# (0,1) AND > VALUE_MIN_EDGE. Example: asian_handicap_-1_5:0.30,h2h:0.18
VALUE_MAX_EDGE_PER_MARKET=
# Inclusive RAW-odds bands, csv "lo-hi" (e.g. 1.8-2.6,3.0-4.2). Empty = only
# the VALUE_MIN_ODDS floor. Which bands are soft must be LEARNED, not assumed.
VALUE_ODDS_BANDS=
# Per-market minimum distinct bookmakers, csv "market_key:count" (e.g.
# over_under_1_5:5) — thin-liquidity skip for new lines/divisions.
VALUE_MIN_BOOKS_PER_MARKET=
# Major-league PREMIUM gate, csv of scraped league names (the per-event
# league_name OddsPortal emits). EMPTY = gate OFF (every league can alert —
# current behavior). When set, a premium-edge pick in a league NOT listed is
# demoted to the silent volume/shadow tier (still CLV-tracked, never alerted,
# no exposure) — so alerts + exposure concentrate on leagues with real sharp
# coverage + liquidity, where the held-out CLV edge actually lives. Obscure
# slates have no free sharp close (~37% coverage is structural), so alerting
# them is noise. Names are matched accent/case/space-insensitively; discover
# the EXACT strings + their measured sharp coverage from the per-league
# match-rate report before enabling. Seed of unambiguous majors (uncomment to
# turn the gate ON):
# VALUE_MAJOR_LEAGUES=Premier League,LaLiga,Serie A,Bundesliga,Ligue 1,UEFA Champions League,UEFA Europa League,NBA,EuroLeague
VALUE_MAJOR_LEAGUES=
# Line-movement / steam-awareness gate (app/edge/steam.py). Default OFF =
# SHADOW: the per-candidate verdict is computed + logged but the tier is
# unchanged (measure before enforcing). True = ENFORCE: a premium candidate is
# DEMOTED to volume (shadow) when the soft price is CONVERGING on the anchor
# (edge correcting) or the anchor is STALE — never alerted, never a silent drop.
VALUE_STEAM_GATE_ENABLED=false
# Trajectory window (s), min fill observations, convergence fraction, opening-gap
# floor, anchor staleness window (s), soft-steam-away flag delta, and whether a
# steam-away flag also demotes. Defaults are sane; tune from the shadow logs.
VALUE_STEAM_LOOKBACK_SECONDS=21600
VALUE_STEAM_MIN_POINTS=2
VALUE_STEAM_CLOSE_FRAC=0.5
VALUE_STEAM_MIN_INITIAL_GAP=0.01
VALUE_STEAM_ANCHOR_STALENESS_SECONDS=7200
VALUE_STEAM_SOFT_STEAM_AWAY_DELTA=0.04
VALUE_STEAM_DEMOTE_ON_SOFT_STEAM=false
# Per-market-type devig override (ADR-0006), csv "market_key:method" (methods:
# multiplicative, additive, power, shin, probit, odds_ratio, logarithmic,
# differential_margin_weighting). Keys = line-qualified market or family; most
# specific wins; unlisted markets keep VALUE_DEVIG. Empty = OFF (every market
# uses VALUE_DEVIG — current behavior). A bad method name fails fast at startup.
# The same map also prices the CLV close, so fill and close never mix methods.
# Example: over_under_2_5:probit,asian_handicap_-1_5:probit
VALUE_DEVIG_PER_MARKET=
# Consensus-fallback anchor as a log-odds (logit) POOL across books instead of
# the price median (build #1). false = median (current behavior). SCOPE: only
# the consensus fallback fair (no sharp book priced the market) — with
# VALUE_REQUIRE_SHARP_ANCHOR=true those picks are already volume/shadow, so this
# sharpens the shadow tier + consensus-vs-median, NOT premium pricing.
VALUE_CONSENSUS_LOGIT_POOL=false
# VISIBILITY-ONLY markets, csv (default empty = NO-OP). A market key here is
# CAPPED at the volume (shadow) tier — never premium, regardless of edge — so a
# brand-new market accrues forward shadow CLV (persisted + CLV-tracked) but is
# NEVER alerted and NEVER reserves exposure. Entries: line-detail keys
# (asian_handicap_-1_5), a family (spreads), or an AH/totals family stem
# (asian_handicap, caps the whole line ladder at once). Football Asian handicap
# goes here while it accrues shadow CLV.
# VALUE_VISIBILITY_ONLY_MARKETS=asian_handicap
VALUE_VISIBILITY_ONLY_MARKETS=
# AH SENTINEL/IMPLAUSIBILITY guard (applied at the AH candidate boundary). A
# 2-way Asian-handicap candidate is REJECTED (mints no pick) when its RAW best
# price exceeds VALUE_AH_MAX_ODDS or its sharp-fair / soft-implied probability
# ratio exceeds VALUE_AH_MAX_SHARP_SOFT_RATIO — a corrupt/sentinel feed price
# (a backtest found odds like 22.0) fabricates a phantom edge. Sane defaults
# (guard ON for AH); scoped to AH so non-AH markets are untouched.
VALUE_AH_MAX_ODDS=15.0
VALUE_AH_MAX_SHARP_SOFT_RATIO=3.0
# MONEYLINE (H2H/1X2) ODDS CEILING. A PREMIUM H2H candidate whose RAW best price
# exceeds this is DEMOTED to the volume/shadow tier: persisted + CLV-tracked,
# never alerted and never reserving exposure. The 1X2 away/draw LONGSHOT band is
# structurally CLV-NEGATIVE; the 2026-07-07 diagnosis measured odds >=4.0 at
# about -0.30 held-out CLV, so the former 5.0 ceiling was tightened to 4.0.
# Scoped to H2H (OU/AH are untouched). Set a large value to effectively disable.
VALUE_MONEYLINE_MAX_ODDS=4.0
# GLOBAL ODDS CEILING — ALL markets (trusted-CLV audit 2026-07-26). A value
# candidate whose RAW best price is >= this ceiling is HARD-DROPPED at the
# candidate boundary (named reason 'global_odds_ceiling'). The odds>=4.0 tail
# measures -0.1479 [-0.2703, -0.0255] trusted CLV across markets (553 soccer +
# 72 tennis spreads >= 4.0 minted post-2026-07-08). Extends the H2H-only
# demote-to-shadow ceiling above to every market. 0 disables.
VALUE_MAX_ODDS=4.0
# Optional drawdown-constrained staking (set BOTH or NEITHER; stakes stay
# informational only): Kelly multiplier becomes min(FRACTIONAL_KELLY, λ*)
# with Pr(drawdown > STAKE_MAX_DRAWDOWN) <= STAKE_MAX_DRAWDOWN_PROBABILITY
# (Busseti-Boyd 2016 single-bet form — app/risk/staking.py). Phase-6 call.
#STAKE_MAX_DRAWDOWN=0.5
#STAKE_MAX_DRAWDOWN_PROBABILITY=0.1
# Uncertainty-shrunk Kelly (Task 5, SHADOW annotation — ships OFF): phi =
# n_eff/(n_eff + kappa) over the pick's (sport, market) settled trusted-CLV
# count; phi/n_eff/shrunk_fraction ride the stake_breakdown JSON only. Flipping
# ENABLED (final = min(shrunk, plain final)) is gated by the ADR-0022
# pre-registered 30-day shadow review — never tune KAPPA on the spent holdout.
STAKE_UNCERTAINTY_SHRINK_ENABLED=false
STAKE_UNCERTAINTY_KAPPA=50
# Optional HYPOTHETICAL bankroll ledger (A8, informational only — no money
# movement, never an input to staking). Unset (default) = ledger inactive;
# set to seed the starting balance and start appending settled P&L per pick.
#BANKROLL_STARTING_BALANCE=1000

# --- Odds / market data (READ-ONLY access only) ----------------------------------
# Free-first ingestion (see docs/research/free-odds-sources.md, ADR-0012).
# ODDS_SOURCE: "oddsportal" (default, FREE — OddsHarvester scrapes
# oddsportal.com, no key), "odds_api" (The Odds API, needs keys below), or
# "oddschecker" (FREE — read-only curl_cffi/Hypernova scrape of oddschecker.com,
# no key). OddsChecker is Cloudflare-blocked on datacenter-direct egress, so it
# REQUIRES SCRAPER_PROXIES; it carries Betfair Exchange + Sportsbook inline, so
# selecting it also moves the Betfair anchor to this provider.
ODDS_SOURCE=oddsportal
# --- OddsChecker (only when ODDS_SOURCE=oddschecker) ---
# Pipeline sport keys to poll (csv). soccer is the only CLV-validated sport; the
# rest come up visibility-only/experimental (shadow-first) under the same gates
# as the oddsportal branch. All supported markets are captured (no market knob).
ODDSCHECKER_SPORTS=soccer,basketball,tennis,american_football
# Daily discovery window (London days: today..today+N-1). 2 = today+tomorrow.
ODDSCHECKER_DAYS=2
# Max concurrent match-page fetches per sport poll.
ODDSCHECKER_MAX_CLIENTS=8
# Capture-only: also persist every sharp-anchored (Betfair Exchange) unmapped
# market (props/period/combo) as Market.OTHER odds history. These NEVER mint
# picks/CLV (not in the devig whitelist, no settlement resolver) — pure odds
# capture. Heavier per match (fetches the all-odds API for every market).
ODDSCHECKER_CAPTURE_SHARP_MARKETS=true
# Slugs must be OddsHarvester league keys (oddsharvester.utils.
# sport_league_constants + our register_extra_leagues additions), or the
# sentinel "all" = NO league filter: dated daily pages covering every league
# (requires ODDSPORTAL_DAYS_AHEAD; cycle time scales with the day's slate).
# Off-season leagues simply yield no events.
ODDSPORTAL_FOOTBALL_LEAGUES=all
# Devig-sound markets only — the loader rejects push-bearing handicap keys
# by design. CYCLE-TIME BUDGET: with leagues=all every key costs one browser
# tab per match on a 100-300+ match daily page (~73s/match measured at 18
# tabs) — config enforces a max of 4 keys per sport when "all" is set; the
# full devig-sound families (documented in app/config.py comments) are for
# scoped-league configs only.
ODDSPORTAL_FOOTBALL_MARKETS=1x2,over_under_2_5,btts,double_chance
# Basketball club competitions (OddsHarvester has no national-team events like
# EuroBasket). On the JSON feed, the totals/handicap wildcard keys fetch every
# priced half-line in one response; fixed NBA-scale lines miss WNBA/college
# totals. "all" = worldwide daily page; empty leagues = basketball off.
ODDSPORTAL_BASKETBALL_LEAGUES=all
ODDSPORTAL_BASKETBALL_MARKETS=home_away,over_under_games,asian_handicap_games
# Tennis is VISIBILITY-ONLY / UNVALIDATED (mints NO picks/alerts, scheduler+
# pipeline-enforced). Default = in-season atp-/wta- slugs (SEASONAL — rotate
# as the tour moves grass->hard->clay); empty = tennis off. Markets kept light
# (ML + the near-universal over/under 2.5 sets); the loader also supports
# over_under_games_* and half-line asian_handicap_*_sets/_games in .env.
ODDSPORTAL_TENNIS_LEAGUES=atp-halle,atp-london,atp-eastbourne,atp-mallorca,atp-wimbledon,wta-berlin,wta-birmingham,wta-eastbourne,wta-bad-homburg,wta-wimbledon
ODDSPORTAL_TENNIS_MARKETS=match_winner,over_under_sets_2_5
# American football / NFL is ALSO VISIBILITY-ONLY / UNVALIDATED (mints NO
# picks/alerts). Its free Pinnacle close is forward-captured via arcadia
# (sport-id 15, in ARCADIA_SPORTS below) — the prerequisite for ever
# CLV-grading NFL picks. Default leagues="nfl" (whole league); off-season the
# dated scrape yields no events. Slugs: nfl,ncaa. Empty = NFL off. home_away
# (moneyline) keeps the visibility scrape light.
ODDSPORTAL_NFL_LEAGUES=nfl
ODDSPORTAL_NFL_MARKETS=home_away
# Opt-in EXPERIMENTAL picks for UNVALIDATED sports (tennis, american football).
# OFF by default — these have not cleared the >2 SE held-out CLV gate (tennis has
# NO free closing line, so it can never be CLV-validated). When true they mint
# picks, but every pick is FORCED to the volume/shadow tier: surfaced +
# CLV-tracked + auto-settled (ESPN), NEVER alerted, NEVER reserving exposure.
ENABLE_UNVALIDATED_PICKS=false
# Free ESPN scores auto-settle basketball/NFL/tennis (read-only SCORES, no key,
# never odds) so the CLOSED tab auto-shows the result + ROI — no manual entry.
ESPN_SETTLE_ENABLED=true
ESPN_SETTLE_SPORTS=soccer,basketball,american_football,tennis
ESPN_SETTLE_DAYS=14
# In-process TTL (seconds) for the settlement feed cache: repeat 30s settle
# cycles inside the TTL reuse the last non-empty football-data/ESPN fetch
# instead of re-hitting the free feeds (~2,880x/day ban risk). 0 disables.
SETTLE_FEED_TTL_SECONDS=1800
# Also auto-settle from the OddsPortal-SCRAPED final score (on the pick's own
# event) so minor leagues with no free results feed settle themselves with NO
# manual entry. Feed/ESPN scores take precedence. The RESULTS tab then shows the
# recorded WON/LOST + auto ROI. Default ON.
SETTLE_FROM_SCRAPED_SCORES=true
# The finished-score scrape runs on its OWN light interval job (separate from
# the heavy odds poll), so results settle promptly even when an odds cycle is
# slow. Each finished match page is scraped + committed individually under the
# per-link timeout, with a per-cycle wall-clock budget, so one hung VPS proxy
# request can't stall the pass. Defaults work in prod with no tuning.
RESULTS_SCRAPE_INTERVAL_SECONDS=60         # cadence of the finished-score job (>=60)
RESULTS_SCRAPE_LINK_TIMEOUT_SECONDS=90.0   # per-match-page scrape timeout (10..300)
RESULTS_SCRAPE_CYCLE_BUDGET_SECONDS=600.0  # per-cycle wall-clock budget (30..3600)
RESULTS_SCRAPE_WINDOW_DAYS=14               # re-scrape stale unscored finished picks this far back (1..90)
# OddsHarvester pacing (human-like; never anti-bot bypassing). Concurrency =
# parallel match pages (3 is human-realistic), request_delay jittered upstream.
# Locale pairs with the loader's forced UTC timezone (London -> en-GB).
ODDSPORTAL_CONCURRENCY=3
ODDSPORTAL_REQUEST_DELAY=1.0
# Match-page navigation (Page.goto) timeout in ms. OddsHarvester hardcodes 15000
# (15s), too tight for OddsPortal's heavy pages — a slow load skips that match
# (re-scraped next cycle). 30000 reduces those timeouts. Bounds: 15000..120000
# (never below upstream's default; capped so a typo can't stall a cycle).
# Raising a timeout is configuration, never an anti-bot bypass.
SCRAPE_NAV_TIMEOUT_MS=30000
# HARD per-scrape-pass watchdog (seconds). A single hung OddsPortal Over/Under
# extraction otherwise made a poll cycle run forever (every later slot skipped,
# settle_results never ran — the cactusbets.cloud incident). Each scrape pass is
# bounded; on timeout the hung scrape is cancelled and the pass is treated as
# empty (recovered next cycle). Bounds 60..7200; default ON, PROD-SAFE with no
# config. Only ever bounds a read-only scrape — never an anti-bot bypass.
SCRAPE_CYCLE_TIMEOUT_SECONDS=900.0
ODDSPORTAL_LOCALE=en-GB
# SELECTABLE per-match odds transport. false (default) = the proven Playwright
# DOM scrape. true = fetch each match's ODDS via the curl_cffi JSON feed (much
# faster + lighter CPU). When true the dated LISTING runs with NO markets (URLs +
# team context only), so the per-match Playwright odds extraction is NEVER paid —
# the savings are real. There is NO Playwright odds fallback: a per-match JSON
# failure is a scrape gap (logged, skipped); a key/bundle rotation fails closed
# with a loud WARNING. Numeric provider ids are mapped to canonical bookmaker
# NAMES (cached GET-only registry); unknown ids are skipped. Finished-score
# capture is unaffected. Keep false until prod-verified. READ-ONLY GET-only.
ODDSPORTAL_USE_JSON_FEED=false
FOOTBALLDATA_LEAGUE_CODES=E0
FOOTBALLDATA_SEASONS=2425,2526
# Set to an in-season non-European code (BRA/ARG/USA/MEX/JPN/CHN) to train
# Dixon-Coles on that league instead of the European seasons. Empty = European.
FOOTBALLDATA_NEW_LEAGUE_CODE=
FOOTBALL_TOTALS_LINE=2.5
MODEL_CONFIDENCE=0.65

# The Odds API key is OPTIONAL (only for ODDS_SOURCE=odds_api); rotation
# supports ODDS_API_KEY_1..3.
ODDS_API_KEY=
ODDS_API_KEY_1=
ODDS_API_KEY_2=
ODDS_API_KEY_3=
# The Odds API regions (csv). "eu" carries Pinnacle AND Betfair Exchange EU; add
# "uk" for Betfair Exchange UK (more credits/request). Both Betfair variants fold
# to "betfair exchange" so they anchor CLV like Pinnacle. (Free path is the
# OddsPortal scrape + Pinnacle ARCADIA; this only applies to ODDS_SOURCE=odds_api.)
ODDS_API_REGIONS=eu

# Pinnacle arcadia sharp-line archive (READ-ONLY, ON by default).
# Clean-room GET-only capture of Pinnacle's PUBLIC guest JSON API — the free
# live-Pinnacle sharp anchor (ADR-0013). Runs ALONGSIDE ODDS_SOURCE; never
# replaces it, mints NO picks. Captured closes land under the isolated
# `pinnacle_<sport>` warehouse namespace. ToS-grey + endpoint-fragile (treat
# scrape gaps as expected). The guest key is OPTIONAL (the endpoints used
# require none) and is NOT an account credential — leave empty unless Pinnacle
# starts requiring it. Set false to disable capture.
ARCADIA_ENABLED=true
ARCADIA_BASE_URL=https://guest.api.arcadia.pinnacle.com/0.1
ARCADIA_GUEST_KEY=
# Best-effort PUBLIC key/base discovery (read-only GET of pinnacle.com's
# /config/app.json web-client blob) — refreshes the guest key + base URL if
# Pinnacle ever rotates them. DEFAULT false = the path is byte-identical to
# today; on ANY failure it falls back to ARCADIA_GUEST_KEY + ARCADIA_BASE_URL.
# The discovered key is a PUBLIC web-client constant, never logged or committed.
ARCADIA_DISCOVER_CONFIG=false
# csv of sport keys to archive. capture_once INTERSECTS this with the live
# /sports feed, so listing more sports than are in-season costs nothing (hidden/
# empty sports are skipped, no matchups fetch wasted). Supported keys:
# soccer,tennis,basketball,american_football,baseball,hockey,rugby,handball.
ARCADIA_SPORTS=soccer,tennis,basketball,american_football
ARCADIA_HORIZON_HOURS=72
ARCADIA_POLL_INTERVAL_SECONDS=120
# Optional Arcadia/Pinnacle outbound proxy rotation. Keep real values in .env
# only; never commit proxy credentials. Format:
# ARCADIA_PROXY_URLS=http://user:pass@host:port,http://user:pass@host:port
ARCADIA_PROXY_URLS=
# Optional rotating proxy pool for the LIVE OddsPortal scrape (read-only GET).
# Empty = scrape from the host IP (default). Routes outbound GET traffic only —
# no login/cookie/session/order path; infra proxies, NOT betting credentials.
# Keep real values in .env ONLY; never commit. Format (pipe-quad, comma-sep):
# SCRAPER_PROXY_POOL=host|port|user|pass,host|port|user|pass
SCRAPER_PROXY_POOL=
# Attach the STRICT cross-source match's Pinnacle ARCHIVE close to picks at
# settlement so incremental CLV anchors on a real sharp close (app/resolution,
# ADR-0013). OFF by default — it changes anchor_type/CLV for matched picks;
# enable only with ARCADIA_ENABLED=true and after validating the match rate.
# 2026-07-12: OPERATOR-SIGNED ON (pre-registered criterion in
# docs/research/2026-07-10-clv-close-freshness-study.md; post-veto re-audit
# 0 wrong/34). Found already live since ~2026-07-01; the signature ratified
# it and the 6 wrong-game NBL1 closes were re-nulled ('wrong_game').
# Rollback = set false (settlement-path only; D2 echo gate stays ON).
CLV_USE_PINNACLE_ARCHIVE=true

# Betfair Exchange BACK-odds capture (read-only; opt-in, OFF) — ADR-0015.
# Dedicated ISOLATED reader of OddsPortal's Betfair Exchange BACK/LAY row, which
# OddsPortal serves on liquidity-rich (major) matches but OddsHarvester's main-
# table parser skips. Captures the BACK side into the isolated `betfair_<sport>`
# warehouse namespace (bookmaker="Betfair Exchange"). Mirrors the arcadia
# archive: runs ALONGSIDE ODDS_SOURCE, mints NO picks/alerts, never touches the
# dashboard/pick path. v1 is the ENABLER only — "betfair exchange" is already a
# SHARP_BOOK with EXCHANGE_COMMISSION in app/edge/value.py, but nothing in v1
# consumes these rows for picks. GET-only/read-only: the page is loaded the same
# way the OddsPortal scrape already loads it. This capture path uses NO Betfair
# login/session/order — it reads the public OddsPortal page. (A SEPARATE, strictly
# read-only Betfair *API* price feed lives under "BETFAIR API" below, behind its
# own enable flag.) OFF by default (a full page-load per match).
BETFAIR_EXCHANGE_ENABLED=false
# Backable £ liquidity floor — a BACK outcome below this is skipped. Small-market
# £12-£23 liquidity is normal; only £0/dust and the '0' empty-cell sentinel are
# gated. Matches the vetted code default. 0 = no gate.
BETFAIR_EXCHANGE_MIN_LIQUIDITY=10
# csv of sport keys to capture. "soccer" (3-way 1X2 BACK row) and "basketball"
# (2-way moneyline BACK row) are supported; "soccer,basketball" works end-to-end.
# A basketball capture only sees fixtures when ODDSPORTAL_BASKETBALL_LEAGUES is
# also set (it reuses the basketball scrape's fixtures).
BETFAIR_EXCHANGE_SPORTS=soccer,basketball
BETFAIR_EXCHANGE_POLL_INTERVAL_SECONDS=300
# D1 close-boost band: events kicking off within this many minutes sort FIRST
# among the cycle's targets (soonest kickoff first), capped at ..._SLOTS of the
# SAME per-cycle budget (a reallocation — zero added load), so the capture
# observes the final pre-kickoff window densely enough for a genuine sharp
# close. Either at 0 disables the band (plain rotation).
BETFAIR_EXCHANGE_CLOSE_BOOST_WINDOW_MINUTES=75
BETFAIR_EXCHANGE_CLOSE_BOOST_SLOTS=20
# Attach the captured Betfair Exchange BACK close to picks at settlement so
# incremental CLV anchors on a real exchange sharp close (EXACT match: the
# betfair event's external_ref is "betfair:"+pick_ref, ADR-0015). OFF by default
# like CLV_USE_PINNACLE_ARCHIVE — it changes anchor_type/CLV for picks with a
# captured betfair close; enable only with BETFAIR_EXCHANGE_ENABLED=true and
# after the coverage report (scripts/reports/betfair_exchange_coverage.py) shows
# real coverage. With CLV_USE_PINNACLE_ARCHIVE also on, Pinnacle wins where both
# price the market (SHARP_BOOKS order); Betfair only fills the gap.
CLV_USE_BETFAIR_EXCHANGE=false
# D2 sharp-close echo gate (ON — correctness): at settlement, drop a sharp
# archive source's close rows when they are BOTH >4h stale at kickoff AND
# provably the pick's own mint-anchor row re-read (older than the pick,
# same source) — the close then falls to the fresh soft consensus with an
# honest closing_anchor_type. Tightening only; false = pre-fix behavior.
CLV_SHARP_CLOSE_ECHO_GATE=true
# Anchor LIVE PICKS on the free Betfair Exchange + Pinnacle ARCADIA sharp prices
# (merged into the scrape at pick time) instead of the soft-book consensus
# median — so picks match the validated Pinnacle-anchored backtest where a free
# sharp price exists. Default OFF (= consensus-anchored, current behavior). Turn
# ON to actually USE Betfair/Pinnacle on getting picks; needs ARCADIA_ENABLED /
# BETFAIR_EXCHANGE_ENABLED populated + (for Betfair) a UK/EU proxy + liquid major.
VALUE_SHARP_ANCHOR_FROM_ARCHIVES=false

# --- BETFAIR API (STRICTLY READ-ONLY market data; opt-in, OFF) --------------
# Direct read-only price feed from the official Betfair Exchange API
# (app/ingestion/betfair_api.py): interactive login -> session token held in
# memory only (NEVER written to disk) -> read-only JSON-RPC market-data calls
# ONLY (listEventTypes / listCompetitions / listEvents / listMarketCatalogue /
# listMarketBook). NO order-placement and NO betting-account method exist in the
# code (enforced by scripts/safety_audit.sh + a unit test). Authorized as a
# read-only exception to Rule 1 by the operator (commit 0e27433).
#
# SHADOW-FIRST + OFF: when enabled it fetches the Betfair Match-Odds catalogue,
# routes each market through the existing hardened cross-source matcher, and LOGS
# the match rate + would-be BACK anchor. It persists NOTHING and does NOT replace
# the OddsPortal-sourced "Betfair Exchange" anchor (measure before trusting).
# Fully INERT when this flag is false OR any credential below is blank.
VALUE_BETFAIR_API_ENABLED=false
# Betfair credentials (fill in .env with ROTATED values — NEVER commit real
# secrets). The App Key is the live/delayed Application Key from your Betfair
# developer account; it is NOT a betting scope. The username/password authenticate
# read-only market-data access only. All three are required; leave any blank to
# keep the integration inert.
BETFAIR_APP_KEY=
BETFAIR_READ_ONLY_USERNAME=
BETFAIR_READ_ONLY_PASSWORD=
# SINGLE dedicated outbound proxy for the Betfair API (NO rotation — one stable
# IP for the session). Format http(s)://[user:pass@]host:port. Empty = direct.
BETFAIR_API_PROXY=
# Shadow-capture cadence (seconds; >=30) and how far ahead (hours) to fetch
# Betfair markets, plus the per-cycle candidate-event cap.
BETFAIR_API_POLL_INTERVAL_SECONDS=300
BETFAIR_API_WINDOW_HOURS=72
BETFAIR_API_MAX_TARGETS_PER_CYCLE=200

# --- BETFAIR STALENESS GUARD (P3, 2026-07-02; defaults INERT) ----------------
# Demote an inline (OddsPortal-scrape) Betfair anchor when a FRESH Betfair-API
# verdict disagrees by more than the tick threshold — fail-closed to the next
# sharp book / consensus (volume tier under VALUE_REQUIRE_SHARP_ANCHOR), never
# a hard pick drop. Verdicts persist in betfair_anchor_verdicts (written by the
# API capture); mint only READS the DB. Requires VALUE_BETFAIR_API_ENABLED.
# Master enable — false = byte-identical (verdicts never loaded at mint).
VALUE_BETFAIR_STALENESS_GUARD=false
# Shadow-first rollout: true = log would-demote + stamp picks, do NOT alter
# anchoring. Flip to false ONLY after reviewing the demote rate on
# GET /resolution/match-rate (live: ~40% of compared selections > 1 tick).
VALUE_BETFAIR_STALENESS_SHADOW=true
# Demotion threshold in Betfair ticks (tick at the coarser price).
VALUE_BETFAIR_STALENESS_TICKS=1.0
# Verdict freshness TTL (seconds; 3 poll cycles). Older verdicts are treated
# as absent (stale_api => no-op): stale API evidence never demotes.
VALUE_BETFAIR_STALENESS_VERDICT_TTL_SECONDS=900

# NOTE: API-Football is SUSPENDED — do not add API_FOOTBALL_KEY; use
# football-data.co.uk / Understat / stats.nba.com fallbacks instead.
